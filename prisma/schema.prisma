generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

// Local: sqlite. Docker / Vercel: postgresql when DATABASE_URL starts with postgresql://
datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Category {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String   @default("")
  imageUrl      String   @default("")
  mark          String   @default("quill")
  markImageUrl  String   @default("")
  accent        String   @default("violet-red")
  sortOrder     Int      @default(0)
  works       Work[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Work {
  id            String    @id @default(cuid())
  title         String
  slug          String    @unique
  excerpt       String    @default("")
  body          Json
  coverImageUrl String    @default("")
  featured      Boolean   @default(false)
  featuredOrder Int       @default(0)
  published     Boolean   @default(false)
  publishedAt   DateTime?
  categoryId    String
  category      Category  @relation(fields: [categoryId], references: [id])
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Settings {
  id           String @id @default("default")
  displayName  String @default("JB")
  tagline      String @default("Words, wrought with care.")
  bio          String @default("")
  about        String @default("")
  aboutWords   String @default("")
  contactEmail String @default("")
  websiteUrl     String @default("https://inkandvoltage.com/")
  websiteLabel   String @default("Visit my website")
  polaroidPhoto  String @default("/hero/photo-v3.jpg")
  polaroidWrite  String @default("/hero/write-v3.jpg")
  polaroidPaint  String @default("/hero/paint-v3.jpg")
  polaroidRead   String @default("/hero/read-v3.jpg")
  heroImage      String @default("/hero/portrait-v6.gif")
  copy           Json   @default("{}")
  socials        Json   @default("[]")
}
