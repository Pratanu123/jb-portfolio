# --- Local (SQLite) ---
DATABASE_URL="file:./dev.db"

# Generate with: openssl rand -base64 32
AUTH_SECRET="generate-a-long-random-string"
AUTH_TRUST_HOST="true"

ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-me"

# --- Docker / VPS (subdomain) ---
# Point the subdomain A/AAAA record at the VPS. Caddy serves 80/443
# and keeps Postgres on the private Docker network.
SITE_HOST="portfolio.yourdomain.com"
ACME_EMAIL="you@yourdomain.com"
AUTH_URL="https://portfolio.yourdomain.com"

POSTGRES_USER="jb"
POSTGRES_PASSWORD="change-me-to-a-long-random-string"
POSTGRES_DB="jb_portfolio"
# Used inside Docker. Local `npm run dev` can keep the SQLite URL above.
# DATABASE_URL="postgresql://jb:change-me-to-a-long-random-string@db:5432/jb_portfolio"
