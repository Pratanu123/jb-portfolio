# --- Local (SQLite) ---
DATABASE_URL="file:./dev.db"

# Generate with: openssl rand -base64 32
AUTH_SECRET="generate-a-long-random-string"
AUTH_TRUST_HOST="true"

ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-me"

# --- Docker / VPS (subdomain) ---
# On the shared inkandvoltage.com VPS, Docker Nginx (not Caddy) terminates
# TLS and proxies portfolio.inkandvoltage.com to the jb-portfolio container.
# Use: docker compose -f docker-compose.yml -f docker-compose.prod.yml up -d --build
SITE_HOST="portfolio.inkandvoltage.com"
ACME_EMAIL="you@yourdomain.com"
AUTH_URL="https://portfolio.inkandvoltage.com"

POSTGRES_USER="jb"
POSTGRES_PASSWORD="change-me-to-a-long-random-string"
POSTGRES_DB="jb_portfolio"
# Used inside Docker. Local `npm run dev` can keep the SQLite URL above.
# DATABASE_URL="postgresql://jb:change-me-to-a-long-random-string@db:5432/jb_portfolio"
